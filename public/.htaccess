# ============================================================
# Brickell Lab — labbrickell.com.ar (Hostinger, Apache/LiteSpeed)
# ============================================================
# ⚠️ LA WEB OFICIAL SE REEMPLAZÓ EL 29/09/2026. Las direcciones de la web
# anterior que Google ya tenía indexadas redirigen con 301 (permanente) a su
# equivalente nuevo, así no se pierde lo ganado ni nadie cae en un 404.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── La web anterior ──
  RewriteRule ^lumina/?$ /#lumina [R=301,L,NE]
  RewriteRule ^lexa/?$ /#lexa [R=301,L,NE]

  # La versión en inglés ya no existe: cada página va a la misma en español.
  RewriteRule ^en/lumina/?$ /#lumina [R=301,L,NE]
  RewriteRule ^en/lexa/?$ /#lexa [R=301,L,NE]
  RewriteRule ^en/(terminos|privacidad)/?$ /$1/ [R=301,L]
  RewriteRule ^en(/.*)?$ / [R=301,L]

  # Borradores de rediseño que llegaron a estar publicados.
  RewriteRule ^(v2|v3|nueva|lab|lafinal)(/.*)?$ / [R=301,L]

  # La vista previa de esta web vivió en /v4 (se pudo haber compartido).
  # ⚠️ SOLO LAS PÁGINAS: las imágenes y los sitios del portfolio siguen en /v4/.
  RewriteRule ^v4/?$ / [R=301,L]
  RewriteRule ^v4/(articulos|blog)/?$ /blog/ [R=301,L]
  RewriteRule ^v4/(articulos|blog)/([a-z0-9-]+)/?$ /blog/$2/ [R=301,L]
  RewriteRule ^v4/(terminos|privacidad)/?$ /$1/ [R=301,L]
</IfModule>

# ── Compresión y caché ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ⚠️ `mod_expires` SOLO NO ALCANZA EN ESTE HOSTING. El bloque de arriba pide un
# año para los assets y el servidor igual responde con
#   Cache-Control: private, max-age=0, no-store, no-cache, must-revalidate
# —medido contra producción con `curl`—, porque LiteSpeed pisa la cabecera. Con
# `mod_headers` la cabecera se escribe de forma explícita y gana.
#
# Astro le pone un hash del contenido al nombre de cada asset, así que son
# inmutables: si cambia el archivo, cambia el nombre. El HTML no se cachea nunca,
# porque es el que apunta a esos nombres.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
