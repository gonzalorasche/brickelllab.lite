---
// Generador. Standalone: NO usa Base.astro.
import './_page.css';
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Avisá si abrís el domingo · Brickell Lab</title>
<meta name="description" content="Armá en 30 segundos la página para avisarle a tus clientes si abrís el domingo. Gratis, sin registro." />
<link rel="canonical" href="https://labbrickell.com.ar/lafinal/" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://labbrickell.com.ar/lafinal/" />
<meta property="og:title" content="El domingo el país se para. ¿Vos abrís?" />
<meta property="og:description" content="Armá gratis la página con los horarios de tu comercio y compartila con tus clientes. En 30 segundos." />
<meta property="og:image" content="https://labbrickell.com.ar/lafinal-og.png" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,700;0,900;1,400;1,900&display=swap" rel="stylesheet" />
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Inter',system-ui,sans-serif;background:#fff;color:#0A0A0C;
       -webkit-font-smoothing:antialiased}
  .lf-split{display:grid;grid-template-columns:1fr}

  .lf-hero{background:#0A1A3C;padding:38px 22px 30px;text-align:center}
  .lf-lab{font-size:11px;letter-spacing:.2em;font-weight:700;display:block}

  /* logo celeste sobre navy · mask usa el alfa del png */
  .lf-logo{display:block;width:132px;height:24px;background-color:#75AADB;
    -webkit-mask:url(/logobrickell.png) no-repeat left center/contain;
    mask:url(/logobrickell.png) no-repeat left center/contain}

  /* logo negro sobre blanco */
  .lf-logo-b{height:14px;width:auto;display:inline-block;vertical-align:-3px;margin-left:5px}
  .lf-h1{font-size:clamp(30px,7.5vw,44px);font-weight:900;letter-spacing:-.045em;
         line-height:1.02;color:#fff;text-wrap:balance;margin-top:14px}
  .lf-h1 span{color:#75AADB}
  .lf-sub{font-size:14px;color:#75AADB;line-height:1.5;margin:10px auto 0;max-width:34ch}

  .lf-que{margin:22px auto 0;padding-top:18px;max-width:38ch;text-align:left;
    border-top:1px solid rgba(117,170,219,.28)}
  .lf-que-l{font-size:9px;letter-spacing:.22em;color:#75AADB;font-weight:700;
    text-transform:uppercase;margin-bottom:9px}
  .lf-que p{font-size:12.5px;line-height:1.65;color:#9DB8D4}
  .lf-que p+p{margin-top:9px}
  .lf-que b{color:#fff;font-weight:700}

  /* --- iPhone --- */
  .lf-preview{background:#0A1A3C;padding:8px 22px 44px;display:flex;flex-direction:column;
              align-items:center;gap:16px}
  .lf-pv-l{font-size:10px;letter-spacing:.2em;color:#75AADB;font-weight:700}
  .lf-ph{--s:.8;width:calc(399px*var(--s));height:calc(836px*var(--s));position:relative;flex:0 0 auto}
  .lf-ph-in{position:absolute;top:0;left:0;width:399px;height:836px;
            transform:scale(var(--s));transform-origin:top left}
  .lf-ph-svg{position:absolute;top:0;left:0;width:399px;height:836px;pointer-events:none}
  .lf-ph-svg.top{z-index:3}
  .lf-ph-screen{position:absolute;top:12px;left:12px;width:375px;height:812px;
                border-radius:44px;overflow:hidden;background:#0A1A3C;z-index:2}
  .lf-ph-status{height:52px;background:#0A1A3C}
  .lf-ph-view{height:760px;overflow:hidden}
  .lf-ph-view>.lf-page{min-height:760px}

  .lf-formcol{padding:34px 22px 40px}
  .lf-form{max-width:460px;margin:0 auto}
  .lf-f{margin-bottom:22px}
  .lf-f>.lf-lab{color:#71717A;margin-bottom:8px}
  .lf-in{width:100%;min-width:0;font-family:inherit;font-size:16px;padding:13px 14px;
         border:1.5px solid #C9C9D1;border-radius:10px;color:#0A0A0C;background:#fff;
         -webkit-appearance:none;appearance:none}
  .lf-in::placeholder{color:#C9C9D1;opacity:1;font-weight:400}
  .lf-in:focus{outline:none;border-color:#0A1A3C}
  .lf-in:disabled{background:#F8F8FA;color:#C9C9D1;border-color:#E9E9ED;cursor:not-allowed}
  .lf-f.off>.lf-lab{color:#C9C9D1}
  .lf-ops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}
  .lf-op{min-width:0;min-height:46px;font-family:inherit;font-size:12.5px;font-weight:700;
         padding:9px 5px;border:1.5px solid #C9C9D1;border-radius:10px;background:#fff;
         color:#52525B;cursor:pointer;letter-spacing:-.01em}
  .lf-op[aria-pressed="true"]{background:#0A1A3C;border-color:#0A1A3C;color:#fff}
  .lf-op small{display:block;font-weight:400;font-size:10px;opacity:.7;margin-top:2px}
  .lf-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}

  .lf-eco{margin-top:9px;background:#F1F4F9;border-left:3px solid #75AADB;
    border-radius:0 8px 8px 0;padding:11px 13px}
  .lf-eco-l{font-size:9px;letter-spacing:.18em;color:#75AADB;font-weight:700;
    text-transform:uppercase;margin-bottom:5px}
  .lf-eco-t{font-size:14px;line-height:1.3;color:#0A1A3C;font-weight:400;letter-spacing:-.02em}
  .lf-eco-t b{font-weight:900}
  .lf-eco-t em{font-weight:900;font-style:italic;color:#2E6FB7}
  .lf-eco-x{font-size:12px;line-height:1.4;color:#71717A;font-style:italic;margin-top:5px}

  .lf-aviso{display:flex;align-items:center;gap:9px;justify-content:center;
    background:#0A1A3C;border-radius:10px;padding:13px;margin-bottom:26px;
    font-size:12.5px;color:#75AADB;font-weight:500;text-align:left}
  .lf-aviso b{color:#fff;font-weight:700}
  .lf-aviso svg{width:15px;height:15px;flex:0 0 auto}
  .lf-pre{position:relative}
  .lf-pre>span{position:absolute;left:14px;top:50%;transform:translateY(-50%);
    font-size:16px;color:#A0A0AB;font-weight:500;pointer-events:none}
  .lf-pre>.lf-in{padding-left:34px}
  .lf-lab small{font-weight:400;letter-spacing:0;color:#A0A0AB}
  .lf-chk{display:flex;gap:11px;align-items:flex-start;padding:15px;background:#F8F8FA;
          border-radius:10px;margin-bottom:8px;cursor:pointer}
  .lf-chk input{width:20px;height:20px;flex:0 0 auto;margin-top:1px;accent-color:#EC1E79}
  .lf-chk span{font-size:13px;line-height:1.45;color:#52525B}
  .lf-nota{font-size:11.5px;color:#A0A0AB;line-height:1.5;margin-bottom:20px}
  .lf-go{width:100%;min-height:52px;font-family:inherit;font-size:13.5px;font-weight:700;
         background:#75AADB;color:#0A1A3C;border:0;border-radius:10px;cursor:pointer;
         text-transform:uppercase;letter-spacing:.14em}
  .lf-go:disabled{opacity:.4;cursor:default}
  .lf-res{display:none;border:1.5px solid #0A1A3C;border-radius:12px;overflow:hidden;margin-top:8px}
  .lf-res-h{background:#0A1A3C;color:#75AADB;font-size:10px;letter-spacing:.2em;
            font-weight:700;padding:9px 14px}
  .lf-res-b{padding:16px 14px}
  .lf-link{font-size:13px;color:#0A1A3C;word-break:break-all;font-weight:500;
           margin-bottom:13px;display:block;text-decoration:none}
  .lf-cp{width:100%;min-height:46px;font-family:inherit;font-size:13px;font-weight:700;
         border-radius:10px;cursor:pointer;margin-bottom:7px;border:1.5px solid #0A1A3C;
         background:#fff;color:#0A1A3C}
  .lf-cp.p{background:#0A1A3C;color:#fff}
  .lf-err{color:#E11D48;font-size:13px;margin-top:10px;display:none}
  .lf-firma{text-align:center;font-size:11px;color:#A0A0AB;padding:24px 0 0}
  .lf-firma a{color:#EC1E79;font-weight:700;text-decoration:none}

  @media (hover:hover){
    .lf-go{transition:background .18s ease,transform .12s ease}
    .lf-go:hover{background:#8FBDE4;transform:translateY(-1px)}
    .lf-go:active{transform:translateY(0)}
    .lf-op{transition:border-color .18s ease,color .18s ease,background .18s ease}
    .lf-op:hover:not([aria-pressed="true"]){border-color:#0A1A3C;color:#0A1A3C;background:#F8FAFC}
    .lf-op[aria-pressed="true"]:hover{background:#132A55}
    .lf-in:not(:disabled):hover{border-color:#A0A0AB}
    .lf-in:not(:disabled):focus:hover{border-color:#0A1A3C}
    .lf-chk{transition:background .18s ease}
    .lf-chk:hover{background:#EDF1F7}
    .lf-cp{transition:background .18s ease,color .18s ease}
    .lf-cp:hover{background:#0A1A3C;color:#fff}
    .lf-cp.p:hover{background:#132A55}
    .lf-link:hover{text-decoration:underline}
  }

  @media (min-width:901px){
    .lf-aviso{display:none}
    body{height:100svh;overflow:hidden}
    .lf-split{grid-template-columns:380px minmax(200px,.9fr) minmax(390px,1.15fr);
              grid-template-rows:100svh;height:100svh}

    /* col 1 · teléfono a altura completa */
    .lf-preview{grid-column:1;grid-row:1;padding:24px 0 24px 32px;justify-content:center;gap:0}
    .lf-pv-l{display:none}
    .lf-ph{--s:.86}

    /* col 2 · info */
    .lf-hero{grid-column:2;grid-row:1;display:flex;flex-direction:column;justify-content:center;
             text-align:left;padding:30px 32px}
    .lf-h1{font-size:clamp(24px,2.1vw,33px);margin-top:12px}
    .lf-sub{font-size:13px;margin:12px 0 0;max-width:32ch}
    .lf-que{margin:20px 0 0;max-width:34ch}
    .lf-que p{font-size:12px}

    /* col 3 · formulario compacto */
    .lf-formcol{grid-column:3;grid-row:1;overflow-y:auto;padding:30px 30px 24px;
                border-left:1px solid #E9E9ED}
    .lf-form{max-width:none}
    .lf-formcol .lf-f{margin-bottom:13px}
    .lf-formcol .lf-lab{margin-bottom:5px}
    .lf-formcol .lf-in{padding:10px 12px;font-size:15px}
    .lf-formcol .lf-pre>span{font-size:15px;left:12px}
    .lf-formcol .lf-pre>.lf-in{padding-left:30px}
    .lf-formcol .lf-op{min-height:40px;font-size:12px;padding:7px 4px}
    .lf-formcol .lf-op small{font-size:9.5px;margin-top:1px}
    .lf-formcol .lf-eco{margin-top:7px;padding:9px 11px}
    .lf-formcol .lf-eco-t{font-size:13px}
    .lf-formcol .lf-chk{padding:11px;margin-bottom:6px}
    .lf-formcol .lf-chk span{font-size:12px}
    .lf-formcol .lf-nota{font-size:11px;margin-bottom:14px}
    .lf-formcol .lf-go{min-height:48px}
    .lf-formcol .lf-firma{padding:14px 0 0}
  }
  @media (min-width:901px) and (max-height:820px){
    .lf-split{grid-template-columns:340px minmax(200px,.9fr) minmax(390px,1.15fr)}
    .lf-ph{--s:.76}
  }
  @media (min-width:901px) and (max-height:740px){
    .lf-split{grid-template-columns:305px minmax(190px,.9fr) minmax(380px,1.15fr)}
    .lf-ph{--s:.68}
  }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  @media (max-width:900px){ .lf-logo{margin:0 auto;-webkit-mask-position:center;mask-position:center} }
</style>
</head>
<body>
<div class="lf-split">

  <section class="lf-hero">
    <span class="lf-logo" role="img" aria-label="Brickell Lab"></span>
    <h1 class="lf-h1">el domingo a las 16<span>.</span><br><span>¿vos abrís?</span></h1>
    <p class="lf-sub">creá la mini página con los horarios de tu comercio y compartila con tus clientes. gratis y en 30 segundos.</p>

    <div class="lf-que">
      <p class="lf-que-l">de qué va esto</p>
      <p>Argentina está en la final y el domingo el país se para. <b>No queremos que ningún comercio se quede sin avisar qué hace ese día,</b> así que lo armamos nosotros y te lo regalamos.</p>
      <p>Elegís cómo querés decirlo, ponés tus horarios y listo. Gratis, sin registro y sin letra chica.</p>
    </div>
  </section>

  <section class="lf-formcol">
    <div class="lf-form">

      <p class="lf-aviso">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
        <span><b>previsualizá tu página</b> abajo antes de publicarla</span>
      </p>

      <div class="lf-f">
        <label class="lf-lab" for="nombre">tu comercio</label>
        <input class="lf-in" id="nombre" type="text" maxlength="34" placeholder="Estudio Vera" />
      </div>

      <div class="lf-f">
        <span class="lf-lab">¿qué hacés el domingo?</span>
        <div class="lf-ops" id="estado">
          <button class="lf-op" type="button" data-v="cerrado"  aria-pressed="true">cerrado</button>
          <button class="lf-op" type="button" data-v="reducido" aria-pressed="false">reducido</button>
          <button class="lf-op" type="button" data-v="abierto"  aria-pressed="false">abierto</button>
        </div>
      </div>

      <div class="lf-f off" id="f-hasta">
        <label class="lf-lab" for="hasta">atendés hasta</label>
        <input class="lf-in" id="hasta" type="time" value="15:00" disabled />
      </div>

      <div class="lf-f">
        <span class="lf-lab">tono</span>
        <div class="lf-ops" id="tono">
          <button class="lf-op" type="button" data-v="gracioso" aria-pressed="true">gracioso<small>humor</small></button>
          <button class="lf-op" type="button" data-v="solemne"  aria-pressed="false">solemne<small>épico</small></button>
          <button class="lf-op" type="button" data-v="neutral"  aria-pressed="false">neutral<small>sin chiste</small></button>
        </div>
        <div class="lf-eco" aria-live="polite">
          <div class="lf-eco-l">tu mensaje</div>
          <p class="lf-eco-t" id="eco-t"></p>
          <p class="lf-eco-x" id="eco-x"></p>
        </div>
      </div>

      <div class="lf-f">
        <span class="lf-lab">¿cómo te escriben? <small>· al menos uno</small></span>
        <input class="lf-in" id="wa" type="tel" inputmode="numeric"
               placeholder="54 9 11 2233 4455" style="margin-bottom:9px" />
        <div class="lf-pre">
          <span>@</span>
          <input class="lf-in" id="ig" type="text" placeholder="estudiovera"
                 autocapitalize="off" autocorrect="off" spellcheck="false" />
        </div>
      </div>

      <label class="lf-chk">
        <input type="checkbox" id="contactar" />
        <span>acepto compartir estos datos desde la página de Brickell Lab</span>
      </label>

      <p class="lf-nota">
        Los datos serán utilizados para mostrarse en el anuncio de la página
        de horarios creada para tu comercio.
      </p>

      <button class="lf-go" id="go">publicar mi página</button>
      <p class="lf-err" id="err"></p>

      <div class="lf-res" id="res">
        <div class="lf-res-h">listo · tu página</div>
        <div class="lf-res-b">
          <a class="lf-link" id="link" target="_blank" rel="noopener"></a>
          <button class="lf-cp p" id="cp-msg">copiar mensaje para whatsapp</button>
          <button class="lf-cp" id="cp-link">copiar solo el link</button>
        </div>
      </div>

      <footer class="lf-firma">hecho por <a href="https://labbrickell.com.ar"><img class="lf-logo-b" src="/logobrickell.png" alt="Brickell Lab" /></a></footer> 
    </div>
  </section>

  <section class="lf-preview">
    <span class="lf-pv-l">así la va a ver tu cliente</span>
    <div class="lf-ph">
      <div class="lf-ph-in">
        <svg class="lf-ph-svg" viewBox="0 0 399 836" fill="none" aria-hidden="true">
          <rect x="0" y="0" width="399" height="836" rx="56" fill="#0A0A0C"/>
          <rect x="2.5" y="2.5" width="394" height="831" rx="53.5" stroke="#3F3F46" stroke-width="1"/>
          <rect x="12" y="12" width="375" height="812" rx="44" fill="#0A1A3C"/>
        </svg>
        <div class="lf-ph-screen">
          <div class="lf-ph-status"></div>
          <div class="lf-ph-view"><div class="lf-page" id="p-page"></div></div>
        </div>
        <svg class="lf-ph-svg top" viewBox="0 0 399 836" fill="none" aria-hidden="true">
          <rect x="139.5" y="26" width="120" height="34" rx="17" fill="#0A0A0C"/>
          <circle cx="243" cy="43" r="5" fill="#1C1C22"/>
        </svg>
      </div>
    </div>
  </section>

</div>

<script>
// @ts-nocheck
import { SB_URL, SB_ANON, render, igUser, COPY, esc } from './_copy.js';
(function(){
  var S = { estado:'cerrado', tono:'gracioso' };
  var $ = function(i){ return document.getElementById(i); };
  function fmtDia(v){
    if(!v) return '';
    var d = new Date(v+'T12:00:00');
    return DIAS[d.getDay()]+' '+d.getDate();
  }

  function slug(v){
    return String(v || '').toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')   // saca acentos
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 28) || 'comercio';
  }
  function nid(nombre){
    var L='abcdefghijkmnpqrstuvwxyz', N='23456789', s='';
    s += L[Math.floor(Math.random()*L.length)];
    s += L[Math.floor(Math.random()*L.length)];
    s += N[Math.floor(Math.random()*N.length)];
    return slug(nombre) + '-' + s;
  }
  function fmtDia(v){
    if(!v) return '';
    var d = new Date(v+'T12:00:00');
    return DIAS[d.getDay()]+' '+d.getDate();
  }
  function datos(){
    return {
      nombre: $('nombre').value.trim(), estado: S.estado, tono: S.tono,
      whatsapp: $('wa').value.replace(/\D/g,'') || null,
      instagram: igUser($('ig').value) || null,
      hasta: S.estado === 'reducido' ? $('hasta').value : null,
      contactar:   $('contactar').checked
    };
  }
  function prev(){
    var d = datos();
    $('p-page').innerHTML = render(d, { inerte:true });

    var c = COPY[S.tono][S.estado];
    var n = esc(String(d.nombre || '').toLowerCase()) || 'nuestro comercio';
    $('eco-t').innerHTML   = c.t.replace(/\{n\}/g, n).replace(/\{h\}/g, esc(d.hasta))
                                .replace(/<br>/g, ' ');
    $('eco-x').textContent = c.x || '';
    $('eco-x').style.display = c.x ? '' : 'none';
  }

  function grupo(id, key){
    var g = $(id);
    g.addEventListener('click', function(e){
      var b = e.target.closest('.lf-op'); if(!b) return;
      S[key] = b.dataset.v;
      g.querySelectorAll('.lf-op').forEach(function(x){
        x.setAttribute('aria-pressed', String(x === b));
      });
      if(key === 'estado'){
        var red = S.estado === 'reducido';
        $('hasta').disabled = !red;
        $('f-hasta').classList.toggle('off', !red);
        if(red) $('hasta').focus();
      }
      prev();
    });
  }

  grupo('estado','estado'); grupo('tono','tono');
  ['nombre','hasta','ig','wa'].forEach(function(i){ $(i).addEventListener('input', prev); });
  prev();

  $('go').addEventListener('click', function(){
    var d = datos();
    $('err').style.display = 'none';
    if(d.nombre.length < 2) return fail('poné el nombre de tu comercio');
    if(!d.contactar) return fail('tenés que aceptar para publicar tu página');
    if(!d.whatsapp && !d.instagram) return fail('dejá al menos un whatsapp o un instagram');
    if(d.whatsapp && d.whatsapp.length < 10)
      return fail('el whatsapp tiene que ir con código de país: 54 9 11...');

    $('go').disabled = true; $('go').textContent = 'publicando…';

    function publicar(intento){
      d.id = nid(d.nombre);
      return fetch(SB_URL+'/rest/v1/lafinal', {
        method:'POST',
        headers:{ apikey:SB_ANON, Authorization:'Bearer '+SB_ANON,
                  'Content-Type':'application/json', Prefer:'return=minimal' },
        body: JSON.stringify(d)
      }).then(function(r){
        if(r.status === 409 && intento < 4) return publicar(intento + 1);
        if(!r.ok) throw new Error('sb');
        return r;
      });
    }

    publicar(1)
    .then(function(){
      var url = location.origin + '/lafinal/ver?id=' + d.id;
      $('link').textContent = url; $('link').href = url;
      $('res').style.display = 'block';
      $('go').style.display = 'none';
      $('res').scrollIntoView({behavior:'smooth', block:'center'});

      var msg = '¡Hola! Te aviso cómo venimos con los horarios del domingo. '
              + 'Acá te dejo toda la info 👉 ' + url;
      $('cp-msg').addEventListener('click', function(){ copy(msg, $('cp-msg'), 'copiar mensaje para whatsapp'); });
      $('cp-link').addEventListener('click', function(){ copy(url, $('cp-link'), 'copiar solo el link'); });
    })
    .catch(function(){
      fail('no pudimos publicarla. probá de nuevo en un rato.');
      $('go').disabled = false; $('go').textContent = 'publicar mi página';
    });
  });

  function copy(txt, btn, orig){
    navigator.clipboard.writeText(txt).then(function(){
      btn.textContent = '¡copiado!';
      setTimeout(function(){ btn.textContent = orig; }, 1600);
    });
  }
  function fail(m){ $('err').textContent = m; $('err').style.display = 'block'; }
})();
</script>
</body>
</html>