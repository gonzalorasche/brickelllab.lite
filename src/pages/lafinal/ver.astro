---
// Standalone: NO usa Base.astro.
import './_page.css';
---
<!doctype html>
<html lang="es-AR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>Horarios del domingo</title>
<meta property="og:type" content="website" />
<meta property="og:title" content="¿Abrimos el domingo?" />
<meta property="og:description" content="Tocá para ver nuestros horarios." />
<meta property="og:image" content="https://labbrickell.com.ar/lafinal-ver-og.png" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;0,700;0,900;1,400;1,900&display=swap" rel="stylesheet" />
<style>
  html,body{margin:0;padding:0;height:100%}
  body{background:#fff;font-family:'Inter',system-ui,sans-serif}
  #lf-app{min-height:100svh;display:flex;flex-direction:column}
  #lf-app>.lf-page{flex:1}
  .lf-estado{padding:60px 22px;text-align:center;color:#A0A0AB;font-size:14px;
    font-family:'Inter',system-ui,sans-serif}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div id="lf-app"><p class="lf-estado">cargando…</p></div>

<script>
// @ts-nocheck
import { SB_URL, SB_ANON, render } from './_copy.js';
(function(){
  var app = document.getElementById('lf-app');
  var id  = new URLSearchParams(location.search).get('id');

  function fail(){
    app.innerHTML = '<p class="lf-estado">no encontramos esta página.<br>'
                  + 'puede que el link esté incompleto.</p>';
  }
  if(!id){ fail(); return; }

  fetch(SB_URL + '/rest/v1/lafinal?id=eq.' + encodeURIComponent(id) + '&select=*', {
    headers: { apikey: SB_ANON, Authorization: 'Bearer ' + SB_ANON }
  })
  .then(function(r){ return r.json(); })
  .then(function(rows){
    if(!rows || !rows.length){ fail(); return; }
    app.innerHTML = '<div class="lf-page">' + render(rows[0]) + '</div>';
  })
  .catch(fail);
})();
</script>
</body>
</html>