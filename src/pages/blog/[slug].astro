---
// ⚠️ LA PÁGINA DE UN ARTÍCULO, MONTADA COMO UNA NOTA DE REVISTA: cabecera con
// la fecha y el titular grande, la foto A SANGRE (de borde a borde), el cuerpo
// en una columna angosta (medida de lectura), la entradilla más grande que el
// resto, los subtítulos con la rayita de la marca, y al pie las preguntas y el
// resto de los artículos.
//
// Lleva Article en datos estructurados y, si el artículo trae preguntas,
// FAQPage: es lo que un motor de respuesta lee para citar. Arriba, una barra
// finita muestra cuánto se leyó.
import V4 from '../../layouts/V4.astro'
import Nav from '../../components/v4/Nav.astro'
import Pie from '../../components/v4/Pie.astro'
import Cookies from '../../components/v4/Cookies.astro'
import ListaArticulos from '../../components/v4/ListaArticulos.astro'
import Volver from '../../components/v4/Volver.astro'
import { ARTICULOS } from '../../data/v4/articulos'
import { SITIO } from '../../data/v4/contacto'

export function getStaticPaths() {
  return ARTICULOS.map((a) => ({ params: { slug: a.slug }, props: { a } }))
}
const { a } = Astro.props
const ruta = `/blog/${a.slug}/`
const jsonld = [
  // BlogPosting con imagen y con el MISMO `@id` de la organización que la home
  // y que Lúmina (`#organization`): así Google ata cada nota al estudio.
  { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: a.titulo, description: a.bajada, image: SITIO + a.imagen.replace('.webp', '-og.jpg'), datePublished: a.fecha, dateModified: a.fecha, inLanguage: 'es-AR', articleSection: a.seccion, author: { '@type': 'Organization', '@id': SITIO + '/#organization', name: 'Brickell Lab', url: SITIO + '/' }, publisher: { '@type': 'Organization', '@id': SITIO + '/#organization', name: 'Brickell Lab', logo: { '@type': 'ImageObject', url: SITIO + '/brickellLogoBlack.png' } }, mainEntityOfPage: SITIO + ruta, isPartOf: { '@id': SITIO + '/#website' } },
  ...(a.faq ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: a.faq.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })) }] : []),
  // La miga de pan: le dice al buscador dónde vive la nota.
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITIO + '/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: SITIO + '/blog/' },
    { '@type': 'ListItem', position: 3, name: a.titulo },
  ] },
]
---
<V4 title={`${a.titulo} — Brickell Lab`} description={a.bajada} ruta={ruta} imagen={a.imagen.replace('.webp', '-og.jpg')} jsonld={jsonld}>
  <Nav />
  <div class="progreso" id="progreso" aria-hidden="true"><i></i></div>
  <div id="smooth-wrapper"><div id="smooth-content">
    <main class="art">
      <header class="art__cab">
        <div class="centro art__cab-caja" data-entra>
          <a class="meta art__volver" href="/blog/">← Blog</a>
          <p class="meta art__meta"><span>{a.fechaTexto}</span><i aria-hidden="true"></i><span>{a.lectura} de lectura</span></p>
          <h1 class="art__titulo">{a.titulo}</h1>
          <p class="art__bajada">{a.bajada}</p>
        </div>
      </header>

      <figure class="art__foto" data-entra="medio">
        <img src={a.imagen} alt={a.imagenAlt} width="1600" height="1000" loading="eager" decoding="async" data-para="34" />
      </figure>

      <div class="centro art__caja">
        <div class="art__cuerpo" set:html={a.cuerpo} />

        {a.faq && (
          <section class="art__faq" aria-label="Preguntas frecuentes">
            <h2>Preguntas frecuentes</h2>
            {a.faq.map((f) => (
              <details class="faq">
                <summary>{f.p}</summary>
                <p>{f.r}</p>
              </details>
            ))}
          </section>
        )}
      </div>

      <div class="centro art__otros" data-entra>
        <ListaArticulos id="otros-articulos" titulo="Seguir leyendo" excluir={a.slug} />
      </div>
    </main>
    <Pie />
  </div></div>

  <Cookies />

  <Volver href="/blog/" etiqueta="Volver al blog" />

  <script is:inline>
    // ⚠️ GSAP SOLO EN ESCRITORIO. El scroll suave no corre en el teléfono, así
    // que ahí ni se bajan las tres librerías (eran ~440 kB de más). Se cargan
    // en orden y recién entonces arranca el resto.
    (function () {
      var arranque = function () { document.dispatchEvent(new Event('gsap:listo')) }
      if (!matchMedia('(min-width: 820px) and (pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) { arranque(); return }
      var urls = [
        'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js',
        'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js',
        'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollSmoother.min.js',
      ]
      var i = 0
      var siguiente = function () {
        if (i >= urls.length) return arranque()
        var s = document.createElement('script')
        s.src = urls[i++]; s.onload = siguiente; s.onerror = arranque
        document.head.appendChild(s)
      }
      siguiente()
    })()
  </script>
  <script is:inline>
    alListo(function () {
      document.getElementById('nav').classList.add('nav--tinta')
      const escritorio = matchMedia('(min-width: 820px) and (pointer: fine)').matches, quieto = matchMedia('(prefers-reduced-motion: reduce)').matches
      let smoother = null
      if (escritorio && !quieto && window.gsap && window.ScrollSmoother) {
        gsap.registerPlugin(ScrollTrigger, ScrollSmoother)
        smoother = window.smoother = ScrollSmoother.create({ wrapper: '#smooth-wrapper', content: '#smooth-content', smooth: 1.2, effects: false, smoothTouch: false, normalizeScroll: true })
        document.documentElement.classList.add('smooth')
        // Con el smoother recién creado: arriba de todo, o en el ancla si la URL la trae.
        const ancla = location.hash && document.querySelector(location.hash)
        // El alto real de la barra: `--barra` leída del :root podía venir vacía y quedaba NaN.
        const irAlAncla = () => smoother.scrollTo(ancla, false, 'top ' + Math.round(document.getElementById('nav').getBoundingClientRect().height) + 'px')
        // Se repite al `load` (y después del refresh de ScrollTrigger, que al
        // recalcular medidas devolvía la página a cero).
        // Igual que arriba: si ya empezaste a scrollear, no se te mueve la página.
        if (ancla) { irAlAncla(); addEventListener('load', () => { ScrollTrigger.refresh(); requestAnimationFrame(() => setTimeout(() => { if (!window.__tocado) irAlAncla() }, 80)) }) }
        else smoother.scrollTo(0, false)
      }
      // La barra de lectura: cuánto se avanzó sobre el cuerpo de la nota.
      const barra = document.querySelector('#progreso i'), cuerpo = document.querySelector('.art__cuerpo')
      if (barra && cuerpo) {
        const y = () => (smoother ? smoother.scrollTop() : scrollY)
        const pintar = () => {
          const arriba = cuerpo.getBoundingClientRect().top + y() - innerHeight * .35
          const largo = Math.max(1, cuerpo.offsetHeight)
          const k = Math.min(1, Math.max(0, (y() - arriba) / largo))
          barra.style.transform = 'scaleX(' + k.toFixed(4) + ')'
        }
        if (smoother) ScrollTrigger.create({ onUpdate: pintar }); else addEventListener('scroll', pintar, { passive: true })
        pintar()
      }
    })
  </script>
</V4>

<style>
  .art { padding-bottom: clamp(56px, 9vh, 110px); }

  /* La barra de lectura, pegada abajo de la barra de navegación. */
  .progreso { position: fixed; z-index: 61; left: 0; right: 0; top: var(--barra); height: 2px; pointer-events: none; }
  .progreso i { display: block; height: 100%; background: var(--marca); transform: scaleX(0); transform-origin: left; }

  /* ── La cabecera: la nota arranca como una tapa ── */
  .art__cab { padding: clamp(36px, 7vh, 80px) var(--margen) clamp(26px, 4vh, 40px); }
  .art__cab-caja { max-width: 860px; display: grid; gap: clamp(14px, 2vh, 20px); }
  .art__volver { color: var(--gris-2); width: max-content; }
  .art__volver:hover { color: var(--tinta); }
  .art__meta { display: flex; align-items: center; gap: 10px; color: var(--gris-2); }
  .art__meta i { width: 14px; height: 1.5px; background: var(--marca); border-radius: 1px; }
  .art__titulo { font-size: clamp(32px, calc(20px + 3.2vw), 68px); font-weight: 600; letter-spacing: -.04em; line-height: 1.02; max-width: 18ch; }
  .art__bajada { font-size: clamp(17px, calc(15.6px + .4vw), 21px); line-height: 1.5; color: var(--gris); max-width: 58ch; }

  /* La foto, a sangre: la nota respira antes de empezar a leerse. */
  .art__foto { margin: 0 0 clamp(30px, 5vh, 56px); aspect-ratio: 16 / 9; background: var(--suave); position: relative; overflow: hidden; }
  .art__foto img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── El cuerpo: columna angosta, medida de lectura ── */
  .art__caja { max-width: 720px; padding: 0 var(--margen); }
  .art__cuerpo { font-size: clamp(17px, calc(16.33px + .185vw), 19px); line-height: 1.7; color: var(--tinta); }
  .art__cuerpo :global(p) { margin: 0 0 1.25em; }
  /* La entradilla: el primer párrafo, más grande, como en una revista. */
  .art__cuerpo :global(p:first-of-type) { font-size: 1.12em; line-height: 1.6; }
  .art__cuerpo :global(h2) { position: relative; font-size: clamp(21px, 1.9vw, 27px); letter-spacing: -.025em; line-height: 1.15; margin: 2.2em 0 .7em; padding-top: 1.1em; max-width: 26ch; }
  .art__cuerpo :global(h2)::before { content: ''; position: absolute; top: 0; left: 0; width: 28px; height: 2px; border-radius: 1px; background: var(--marca); }
  .art__cuerpo :global(h3) { font-size: 19px; margin: 1.8em 0 .5em; }
  .art__cuerpo :global(ul), .art__cuerpo :global(ol) { margin: 0 0 1.25em; padding-left: 1.2em; display: grid; gap: .45em; }
  .art__cuerpo :global(li)::marker { color: var(--gris-2); }
  .art__cuerpo :global(blockquote) { margin: 1.8em 0; padding-left: 20px; border-left: 2px solid transparent; border-image: var(--marca) 1; font-size: 1.1em; line-height: 1.45; letter-spacing: -.01em; }
  .art__cuerpo :global(blockquote p) { margin: 0; }
  .art__cuerpo :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--linea-2); }
  .art__cuerpo :global(a:hover) { text-decoration-color: #B23CFF; }
  .art__cuerpo :global(strong) { font-weight: 600; }
  .art__cuerpo :global(img) { width: 100%; height: auto; border-radius: 14px; margin: 1.6em 0; }

  /* ── Las preguntas ── */
  .art__faq { margin-top: clamp(40px, 7vh, 64px); padding-top: clamp(28px, 4vh, 40px); border-top: 1px solid var(--linea); }
  .art__faq h2 { font-size: clamp(21px, 1.9vw, 27px); letter-spacing: -.025em; margin-bottom: 18px; }
  .faq { border-top: 1px solid var(--linea); }
  .faq:last-of-type { border-bottom: 1px solid var(--linea); }
  .faq summary { cursor: pointer; padding: 16px 0; font-weight: 500; font-size: 17px; list-style: none; position: relative; padding-right: 32px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 4px; top: 14px; font-size: 20px; color: var(--gris-2); }
  .faq[open] summary::after { content: '–'; }
  .faq p { padding: 0 0 18px; color: var(--gris); max-width: 62ch; line-height: 1.6; }

  /* El resto de los artículos, al final de la nota. */
  .art__otros { max-width: var(--ancho); margin-top: clamp(48px, 8vh, 88px); padding: clamp(28px, 4vh, 44px) var(--margen) 0; border-top: 1px solid var(--linea); }

  /* En el teléfono manda la flechita flotante (ver Volver.astro). */
  @media (max-width: 899px) { .art__volver { display: none; } }
  @media (min-width: 900px) { .art__foto { aspect-ratio: 21 / 9; } }
</style>
