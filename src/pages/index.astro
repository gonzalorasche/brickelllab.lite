---
import Base from '../layouts/Base.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ecosistema from '../components/Ecosistema.astro';
import Agencia from '../components/Agencia.astro';
import Servicios from '../components/Servicios.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Brickell Lab | Agencia de Desarrollo Web & Diseño Digital"
  schema={true}
>
  <SeoSchema slot="schema" />
  <Header lang="es" />
  <main>
    <Hero />
    <Ecosistema lang="es" />
    <Agencia lang="es" />
    <Servicios lang="es" />
    <Contacto lang="es" />
  </main>
  <Footer lang="es" />
</Base>