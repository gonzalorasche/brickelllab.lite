---
// src/pages/lexa.astro
import Base from '../layouts/Base.astro';
import HeaderLexa from '../components/HeaderLexa.astro';
import FooterLexa from '../components/FooterLexa.astro';
import SeoSchemaLexa from '../components/SeoSchemaLexa.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);

const waLexa = `https://wa.me/5491164680800?text=${encodeURIComponent(t('lx.wa.text'))}`;

const servicios = [
  { n: t('lx.serv.1.n'), d: t('lx.serv.1.d'), destacado: true },
  { n: t('lx.serv.2.n'), d: t('lx.serv.2.d'), destacado: false },
  { n: t('lx.serv.3.n'), d: t('lx.serv.3.d'), destacado: false },
  { n: t('lx.serv.4.n'), d: t('lx.serv.4.d'), destacado: false },
];

const areas = [
  t('lx.area.0'), t('lx.area.1'), t('lx.area.2'),
  t('lx.area.3'), t('lx.area.4'), t('lx.area.5'),
];
---
<Base
  title="Lexa | Traducción de inglés matriculada — Brickell Lab"
  description="Traducción pública y especializada de inglés con matrícula del CTPCBA. 20 años traduciendo documentos personales, legales, médicos y educativos. Parte del ecosistema Brickell Lab."
  canonical="https://labbrickell.com.ar/lexa"
  schema={true}
>
  <SeoSchemaLexa slot="schema" />
  <HeaderLexa lang={lang} />

  <main class="lx">

    <!-- HERO -->
    <section class="lx-hero" aria-label="Lexa — traducción de inglés">
      <div class="lx-hero-media">
        <picture>
          <source media="(max-width: 900px) and (orientation: portrait)" srcset="/lexamobile.jpg" />
          <img src="/lexa.jpg" alt={t('lx.hero.img.alt')} fetchpriority="high" loading="eager" decoding="async" />
        </picture>
      </div>
      <div class="lx-hero-content">
        <span class="lx-eyebrow">{t('lx.hero.eyebrow')}</span>
        <h1 class="lx-hero-title">{t('lx.hero.title.pre')}<br/>{t('lx.hero.title.mid')}<br/><em>{t('lx.hero.title.em')}</em></h1>
        <p class="lx-hero-lede">
          {t('lx.hero.lede')}
        </p>
        <div class="lx-hero-cta">
          <a href={waLexa} target="_blank" rel="noopener" class="lx-btn lx-btn-y">
            {t('lx.hero.cta')}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <span class="lx-pill-exp"><strong>{t('lx.hero.exp.strong')}</strong>&nbsp;{t('lx.hero.exp.rest')}</span>
        </div>
      </div>
    </section>

    <!-- MANIFIESTO -->
    <section class="lx-mani" aria-label="Por qué Lexa">
      <div class="lx-mani-in">
        <span class="lx-badge lx-badge-dark lx-reveal">{t('lx.mani.badge')}</span>
        <p class="lx-mani-text lx-reveal">
          {t('lx.mani.pre')}<em>{t('lx.mani.em')}</em>{t('lx.mani.post')}
        </p>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section class="lx-serv" id="servicios" aria-label="Servicios de Lexa">
      <div class="lx-serv-in">
        <header class="lx-serv-head lx-reveal">
          <span class="lx-badge lx-badge-dark">{t('lx.serv.badge')}</span>
          <h2 class="lx-h2">{t('lx.serv.title.pre')}<em>{t('lx.serv.title.em')}</em></h2>
        </header>
        <div class="lx-serv-grid">
          {servicios.map((s) => (
            <article class={`lx-card lx-reveal ${s.destacado ? 'is-featured' : ''}`}>
              {s.destacado && <span class="lx-card-tag">{t('lx.serv.tag')}</span>}
              <h3 class="lx-card-t">{s.n}</h3>
              <p class="lx-card-d">{s.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- AREAS -->
    <section class="lx-areas" aria-label="Áreas de especialidad">
      <div class="lx-areas-in">
        <span class="lx-badge lx-badge-dark lx-reveal">{t('lx.areas.badge')}</span>
        <h2 class="lx-h2 lx-reveal">{t('lx.areas.title')}</h2>
        <div class="lx-chips lx-reveal">
          {areas.map((a) => <span class="lx-chip">{a}</span>)}
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section class="lx-cta" id="contacto" aria-label="Contacto Lexa">
      <div class="lx-cta-in lx-reveal">
        <h2 class="lx-cta-title">{t('lx.cta.title')}</h2>
        <p class="lx-cta-lede">{t('lx.cta.lede')}</p>
        <div class="lx-cta-actions">
          <a href={waLexa} target="_blank" rel="noopener" class="lx-btn lx-btn-y">
            {t('lx.cta.btn')}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <FooterLexa lang={lang} />
</Base>

<style>
  /* ===== Base Lexa (fondo claro) ===== */
  .lx{ background:var(--surface); color:var(--text-primary); }
  .lx em{ font-style:italic; color:var(--magenta); }

  .lx-badge{
    display:inline-block; margin-bottom:20px;
    font-size:10px; font-weight:var(--fw-semibold); letter-spacing:.16em; text-transform:uppercase;
    color:#fff; background:var(--magenta); padding:6px 13px; border-radius:var(--r-pill);
  }
  .lx-badge-dark{ color:#fff; background:#0B0B0B; }
  .lx-eyebrow{
    display:inline-block; margin-bottom:20px;
    font-size:11px; font-weight:var(--fw-semibold); letter-spacing:.16em; text-transform:uppercase;
    color:var(--text-muted);
  }
  .lx-h2{
    margin:0; font-size:clamp(28px,3.4vw,46px); font-weight:var(--fw-bold);
    letter-spacing:-.035em; line-height:1.05; color:var(--text-primary); text-wrap:balance;
  }

  .lx-btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:14px 24px; border-radius:var(--r-md);
    font-size:14.5px; font-weight:var(--fw-semibold); text-decoration:none;
    transition:background var(--dur) var(--ease), transform var(--dur-fast) var(--ease), border-color var(--dur) var(--ease);
  }
  .lx-btn-y{ background:var(--magenta); color:#fff; }
  .lx-btn-y:hover{ background:#C4185F; transform:translateY(-2px); }
  .lx-btn-y svg{ transition:transform var(--dur) var(--ease); }
  .lx-btn-y:hover svg{ transform:translateX(3px); }

  /* ===== HERO ===== */
  .lx-hero{
    position:relative; display:grid; grid-template-columns:1fr 1fr; align-items:stretch;
    min-height:100dvh; background:var(--surface);
  }
  .lx-hero-media{ position:absolute; top:0; right:0; bottom:0; width:50%; overflow:hidden; }
  .lx-hero-media img{ width:100%; height:100%; object-fit:cover; object-position:center bottom; display:block; }
  .lx-hero-media::before{ display:none; }
  .lx-hero-content{
    grid-column:1; display:flex; flex-direction:column; justify-content:center;
    padding:clamp(40px,6vh,80px) var(--gutter);
    position:relative; z-index:2;
  }
  .lx-hero-title{
    margin:0; font-size:clamp(38px,5vw,68px); font-weight:var(--fw-bold);
    letter-spacing:-.045em; line-height:1.02; color:var(--text-primary);
  }
  .lx-hero-lede{
    margin:clamp(20px,2.4vw,28px) 0 0; max-width:46ch;
    font-size:clamp(16px,1.2vw,19px); line-height:1.6; color:var(--text-secondary);
  }
  .lx-hero-cta{ display:flex; flex-direction:column; align-items:flex-start; gap:14px; margin-top:clamp(28px,3.4vw,40px); }
  .lx-pill-exp{
    display:inline-flex; align-items:center;
    font-size:11px; color:var(--text-secondary);
    background:var(--n-100); border-radius:var(--r-pill); padding:6px 12px;
  }
  .lx-pill-exp strong{ color:var(--text-primary); font-weight:var(--fw-semibold); }

  /* ===== MANIFIESTO ===== */
  .lx-mani{ background:var(--n-100); padding-block:clamp(64px,8vh,110px); }
  .lx-mani-in{ width:100%; padding:0 var(--gutter); }
  .lx-mani-text{
    margin:0; max-width:38ch; font-size:clamp(24px,3vw,40px); font-weight:var(--fw-semibold);
    letter-spacing:-.02em; line-height:1.28; color:var(--text-primary);
  }

  /* ===== SERVICIOS ===== */
  .lx-serv{ padding-block:clamp(64px,8vh,110px); background:var(--surface); }
  .lx-serv-in{ width:100%; padding:0 var(--gutter); }
  .lx-serv-head{ margin-bottom:clamp(36px,4vw,52px); }
  .lx-serv-grid{
    display:grid; grid-template-columns:repeat(2,1fr); gap:clamp(16px,2vw,22px);
    align-items:stretch;
  }
  .lx-card{ height:100%; min-height:200px; }
  .lx-card{
    position:relative; background:var(--surface); border:1px solid var(--border);
    border-radius:16px; padding:clamp(26px,2.6vw,36px); box-shadow:var(--shadow-sm);
    transition:border-color var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .lx-card:hover{ border-color:var(--border-strong); transform:translateY(-3px); box-shadow:var(--shadow-md); }
  .lx-card.is-featured{ border:2px solid var(--magenta); }
  .lx-card-tag{
    display:inline-block; margin-bottom:14px;
    font-size:10px; font-weight:var(--fw-semibold); letter-spacing:.12em; text-transform:uppercase;
    color:#fff; background:var(--magenta); padding:5px 11px; border-radius:var(--r-pill);
  }
  .lx-card-t{ margin:0 0 10px; font-size:clamp(20px,1.8vw,26px); font-weight:var(--fw-bold); letter-spacing:-.02em; color:var(--text-primary); }
  .lx-card-d{ margin:0; font-size:15px; line-height:1.6; color:var(--text-secondary); }

  /* ===== AREAS ===== */
  .lx-areas{ background:var(--n-100); padding-block:clamp(64px,8vh,110px); }
  .lx-areas-in{ width:100%; padding:0 var(--gutter); }
  .lx-areas .lx-h2{ margin-top:0; margin-bottom:clamp(28px,3vw,40px); }
  .lx-chips{ display:flex; flex-wrap:wrap; gap:9px; }
  .lx-chip{
    font-size:12.5px; font-weight:var(--fw-semibold); color:var(--text-secondary);
    background:var(--surface); border:1px solid var(--border); border-radius:var(--r-pill); padding:7px 14px;
    transition:border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .lx-chip:hover{ border-color:var(--magenta); color:var(--magenta); }

  /* ===== CTA CONTACTO ===== */
  .lx-cta{ padding-block:clamp(72px,9vh,120px); background:var(--surface); }
  .lx-cta-in{ width:100%; padding:0 var(--gutter); text-align:center; }
  .lx-cta-title{ margin:0; font-size:clamp(30px,4vw,54px); font-weight:var(--fw-bold); letter-spacing:-.04em; line-height:1.05; color:var(--text-primary); }
  .lx-cta-lede{ margin:18px auto 0; max-width:52ch; font-size:clamp(16px,1.2vw,18px); line-height:1.6; color:var(--text-secondary); }
  .lx-cta-actions{ display:flex; align-items:center; justify-content:center; gap:14px; margin-top:clamp(28px,3vw,38px); flex-wrap:wrap; }

  /* ===== MOBILE ===== */
  @media (max-width:900px) and (orientation:portrait){
    .lx-hero{ display:flex; flex-direction:column; min-height:100vh; height:100vh; }
    .lx-hero-media{ position:relative; width:100%; height:44vh; order:1; flex:0 0 auto; }
    .lx-hero-media::before{ display:none; }
    .lx-hero-content{ order:2; flex:1 1 auto; justify-content:flex-start; padding:clamp(28px,7vw,44px) var(--gutter) clamp(40px,9vw,56px); overflow:visible; }
  }
  @media (max-width:900px){
    .lx-serv-grid{ grid-template-columns:1fr; }
  }
  @media (max-width:900px) and (orientation:landscape){
    .lx-hero{ min-height:100vh; height:100vh; }
    .lx-hero-media img{ object-position:left center; }
    .lx-hero-content{ justify-content:center; padding-block:clamp(16px,4vh,32px); }
    .lx-eyebrow{ margin-bottom:10px; }
    .lx-hero-title{ font-size:clamp(24px,4.5vw,34px); }
    .lx-hero-lede{ font-size:13.5px; line-height:1.5; margin-top:12px; }
    .lx-hero-cta{ margin-top:16px; gap:10px; }
    .lx-btn{ padding:11px 20px; font-size:13.5px; }
  }

  /* ===== Reveal ===== */
  .lx-reveal{ opacity:0; transform:translateY(20px); }
  .lx-reveal.is-in{ opacity:1; transform:none; transition:opacity .6s var(--ease-out), transform .6s var(--ease-out); }
  @media (prefers-reduced-motion:reduce){
    .lx-reveal{ opacity:1; transform:none; }
    .lx-reveal.is-in{ transition:none; }
    .lx-card:hover{ transform:none; }
  }
</style>

<script is:inline>
  (function(){
    var els = document.querySelectorAll('.lx-reveal');
    if(!els.length) return;
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold:0, rootMargin:'0px 0px -10% 0px' });
    els.forEach(function(el){ io.observe(el); });
  })();
</script>