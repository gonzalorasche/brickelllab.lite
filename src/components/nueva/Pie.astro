---
// src/components/nueva/Pie.astro
//
// EL PIE, portado del de Lúmina y vestido de Brickell.
//
// Dos zonas: la navegación y la banda de cierre.
//
// ⚠️ ES OSCURO, y no por gusto: es lo último que se ve y lo que le pone un fondo
// a la página. Con un pie claro, la home termina en el mismo blanco con el que
// venía y no se entiende que se acabó — el scroll llega al final y parece que
// falta algo.
//
// ⚠️ NO HAY ÚLTIMA LLAMADA A LA ACCIÓN, y es deliberado. La página ya tiene dos
// caminos a contacto —el botón de la barra, siempre a la vista, y la sección de
// Contacto entera— y un tercero acá no agregaría una salida: agregaría una
// repetición al final, donde lo que se espera es el cierre. El pie queda siendo
// lo que un pie es: navegación, firma y legales.
//
// ────────────────────────────────────────────────────────────
// LAS REDES VAN EN LA BANDA, NO EN UNA ZONA PROPIA
// ────────────────────────────────────────────────────────────
//
// Cinco íconos no dan para una franja con su borde: ahí se leerían como una
// sección más. En la banda son lo que son —una firma al pie, al lado del
// copyright— y de paso la banda deja de ser un renglón de letra chica y pasa a
// cerrar de verdad.
//
// Cada grupo lleva su rótulo AL LADO de sus íconos y no encima: en una fila de
// una sola línea, el rótulo arriba obliga a dos renglones y parte la banda al
// medio.
//
// ⚠️ ESTÁN LAS DE TODO EL ECOSISTEMA, como en el pie de Lúmina: las cuatro del
// estudio y la de Lúmina. Lexa no tiene cuentas propias —no existen en ningún
// lado del proyecto— así que no se le inventa ninguna.
//
// ⚠️ LOS DIBUJOS SON LOS DE `components/landing/Redes.tsx` DE LÚMINA, incluidas
// sus ventanas recortadas. Los cinco venían con `viewBox="0 0 24 24"` pero no
// llenan la caja igual —medido allá: Instagram y LinkedIn dibujan 15,83px, X
// 12,43 y TikTok apenas 10,29, y encima corrido—, así que X y TikTok llevan un
// `viewBox` recortado a su dibujo. Al achicar la ventana el trazo se agranda en
// la misma proporción, y por eso TikTok lleva su `stroke-width` compensado.
// Copiar los `path` sin las ventanas deja la fila despareja.
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const p = lang === 'en' ? '/en' : '';

const anio = new Date().getFullYear();

/** Las secciones de esta página. Es el pie: van TODAS, también las que la barra
    esconde por falta de lugar. Mostrar lo que arriba no cabía es su trabajo. */
const SECCIONES = [
  { a: '#ecosistema', txt: t('footer.nav.eco') },
  { a: '#servicios', txt: t('footer.nav.services') },
  { a: '#proceso', txt: 'Cómo trabajamos' },
  { a: '#contacto', txt: t('footer.nav.contact') },
];

const ECOSISTEMA = [
  { a: `${p}/lumina`, txt: 'Lúmina' },
  { a: `${p}/lexa`, txt: 'Lexa' },
];

/**
 * ⚠️ EL TELÉFONO NO SE ESCRIBE, DICE "WHATSAPP". Un número a la vista en el pie
 * de una web pública es lo que levantan los raspadores de datos, y termina en
 * listas de spam y llamadas automáticas. El link hace exactamente lo mismo para
 * una persona —abre el chat, y encima con el mensaje ya escrito— sin dejar el
 * número en el HTML como texto. Es lo que ya hacía el pie actual del sitio.
 */
const WA_TEXTO = lang === 'en'
  ? 'Hi Brickell Lab, I would like to get in touch'
  : 'Hola, quiero contactarme con Brickell Lab';
const WA = `https://wa.me/5491162770800?text=${encodeURIComponent(WA_TEXTO)}`;
const MAIL = 'info@labbrickell.com.ar';

const RS_ESTUDIO = [
  { k: 'ig', href: 'https://instagram.com/brickell.lab', et: 'Brickell Lab en Instagram' },
  { k: 'in', href: 'https://www.linkedin.com/company/brickell-lab', et: 'Brickell Lab en LinkedIn' },
  { k: 'x', href: 'https://x.com/LabBrickell', et: 'Brickell Lab en X' },
  { k: 'tt', href: 'https://tiktok.com/@brickell.lab', et: 'Brickell Lab en TikTok' },
];
---

<footer class="bl-pie">
  {/* ═══ LA NAVEGACIÓN ═══ */}
  <div class="bl-wrap bl-pie-nav">
    <div class="bl-pie-marca">
      {/* ⚠️ EL MISMO LOGO QUE LA BARRA, no `logofooter.png`. Ese archivo es sólo
          el isotipo —114×164, vertical— y a 26px de alto queda una marquita de
          18px de ancho: al pie se lee como otra marca distinta de la de arriba.
          El logotipo completo, dado vuelta a blanco, cierra con lo mismo con lo
          que abre la página. */}
      <img class="bl-pie-logo" src="/logobrickell.png" alt="Brickell Lab" loading="lazy" decoding="async" />
      <p>{t('footer.tagline')}</p>
    </div>

    <nav class="bl-pie-cols" aria-label={t('footer.nav.title')}>
      <div>
        <span class="tit">{t('footer.nav.title')}</span>
        <ul>
          {SECCIONES.map((s) => <li><a href={s.a}>{s.txt}</a></li>)}
        </ul>
      </div>

      <div>
        <span class="tit">{t('footer.eco.title')}</span>
        <ul>
          {ECOSISTEMA.map((e) => <li><a href={e.a}>{e.txt}</a></li>)}
          <li>
            <a href="https://lumina.labbrickell.com.ar/" target="_blank" rel="noopener noreferrer">
              Ir a la plataforma
              <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <span class="tit">{t('footer.contact.title')}</span>
        <ul>
          <li>
            <a href={WA} target="_blank" rel="noopener noreferrer">
              WhatsApp
              <svg class="ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
            </a>
          </li>
          <li><a href={`mailto:${MAIL}`}>{MAIL}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  {/* ═══ LA BANDA DE CIERRE ═══ */}
  <div class="bl-pie-banda">
    <div class="bl-wrap fila">
      <span class="copy">© {anio} Brickell Lab. {t('footer.rights')}</span>

      <div class="bl-pie-redes">
        <div class="grupo">
          <span class="q">Brickell Lab</span>
          {RS_ESTUDIO.map((r) => (
            <a class="rs" href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.et}>
              {r.k === 'ig' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
              )}
              {r.k === 'in' && (
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M7 10.5V17M7 7.2v.1M11 17v-3.6a2.4 2.4 0 0 1 4.8 0V17"/></svg>
              )}
              {r.k === 'x' && (
                /* El glifo de la marca, relleno: dos diagonales cruzadas no son
                   el logo de X, son una equis. */
                <svg viewBox="2.23 2.58 18.84 18.84" aria-hidden="true"><path d="M4 4.5h3.6l4.1 5.6 4.9-5.6H19l-6.1 7 6.6 8H15.9l-4.5-6-5.2 6H3.8l6.6-7.6z" fill="currentColor" stroke="none"/></svg>
              )}
              {r.k === 'tt' && (
                <svg viewBox="4.80 1.55 17.39 17.39" stroke-width="1.23" aria-hidden="true"><path d="M15 3v10.5a4 4 0 1 1-3.4-3.96"/><path d="M15 6.4A5.2 5.2 0 0 0 20 8.6"/></svg>
              )}
            </a>
          ))}
        </div>

        <div class="grupo">
          <span class="q">Lúmina</span>
          <a class="rs" href="https://instagram.com/labbrickell.lumina" target="_blank" rel="noopener noreferrer" aria-label="Lúmina en Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>

      <div class="legales">
        {/* ⚠️ EN PESTAÑA NUEVA. Las páginas legales no tienen botón de volver
            —se llega a ellas desde cinco lugares distintos y no hay un "atrás"
            correcto— así que abrirlas en la misma pestaña dejaría a alguien
            leyendo veinte párrafos de términos sin más salida que el atrás del
            navegador. Cerrando la pestaña, la página sigue donde estaba. */}
        <a href={`${p}/terminos`} target="_blank" rel="noopener">{t('footer.legal.terms')}</a>
        <a href={`${p}/privacidad`} target="_blank" rel="noopener">{t('footer.legal.privacy')}</a>
        {/* ⚠️ ESTE BOTÓN NO ES DECORATIVO Y NO SE PUEDE PERDER: es el único punto
            de toda la página donde alguien que ya aceptó o rechazó las cookies
            puede cambiar de opinión. Borra la preferencia guardada y recarga,
            que es lo que vuelve a mostrar el panel de consentimiento. Sin él, la
            decisión es para siempre. Mismo `id` que el del pie actual. */}
        <button type="button" id="ftCookies" class="cookies">{t('footer.legal.cookies')}</button>
      </div>
    </div>
  </div>
</footer>

<script>
  // Reabre el panel de consentimiento: borra la preferencia y recarga.
  const ftCookies = document.getElementById('ftCookies');
  ftCookies?.addEventListener('click', () => {
    try { localStorage.removeItem('bl_cookie_consent'); } catch (e) {}
    location.reload();
  });
</script>
