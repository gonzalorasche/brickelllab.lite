---
// src/components/nueva/Nav.astro
//
// LA BARRA. Flota sobre el hero sin fondo y se pone de vidrio recién cuando la
// página se movió: es lo que hace que el hero se lea de borde a borde en vez de
// arrancar debajo de una franja blanca.
//
// El panel lateral reemplaza al menú en teléfono. No es un mega-menú: son los
// cuatro destinos y el botón, porque la home tiene cuatro secciones y un menú
// con submenús para cuatro anclas es teatro.
import { useTranslations } from '../../i18n/utils';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const p = lang === 'en' ? '/en' : '';

/* Dos destinos. La página tiene cinco secciones y el menú lleva las dos que
   alguien busca por nombre. Cómo trabajamos se lee de paso, y Contacto lo
   resuelve el botón de al lado. Un menú es para saltar, no para listar lo que
   hay. */
/* ⚠️ SIN "CONTACTO" EN LOS LINKS: el botón de al lado lleva al mismo lugar.
   Tener las dos cosas es ofrecer dos veces la misma puerta, y la que pierde es la
   que parece un link secundario. Queda el botón. */
/* ⚠️ EN EL ORDEN EN QUE APARECEN EN LA PÁGINA. Un menú que lista los destinos
   en otro orden del que se recorren obliga a rehacer el mapa mental cada vez que
   se scrollea. Si mañana se reordenan las secciones, esto se reordena con ellas. */
const links = [
  { href: '#servicios', label: t('footer.nav.services') },
  { href: '#ecosistema', label: t('footer.nav.eco') },
];
---

<header class="bl-nav" id="bl-nav">
  <div class="bl-nav-in">
    <a class="bl-logo" href={p === '' ? '/nueva' : `${p}/nueva`} aria-label="Brickell Lab">
      <img src="/logobrickell.png" alt="Brickell Lab" decoding="async" />
    </a>

    <nav class="bl-links" aria-label={t('footer.nav.title')}>
      {links.map((l) => <a class="bl-link" href={l.href}>{l.label}</a>)}
    </nav>

    {/* ⚠️ DICE "CONTACTO" Y NO LA LLAMADA LARGA, A DIFERENCIA DEL BOTÓN DEL HERO.
        Son dos cosas distintas: el del hero es la invitación —tiene lugar y le
        toca convencer—, éste es un ítem de navegación que vive al lado de
        "Ecosistema", "Servicios" y "Planes" y tiene que leerse como uno de ellos.
        Con la frase entera medía 264px y le ganaba en peso a la barra completa.

        ⚠️ Y USA `footer.nav.contact`, QUE YA EXISTÍA TRADUCIDA en los dos idiomas
        —"Contacto" / "Contact"—, en lugar de una clave nueva. Es la misma palabra
        para la misma sección: duplicarla sería tener dos textos que hay que
        acordarse de cambiar juntos. */}
    <a class="bl-btn bl-btn--solid bl-nav-cta" href="#contacto">
      {t('footer.nav.contact')}
    </a>

    <button class="bl-burger" type="button" aria-label="Menú" aria-expanded="false" aria-controls="bl-panel" id="bl-burger">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>
</header>

<!-- ⚠️ EL PANEL VIVE FUERA DE LA BARRA, no adentro. La barra es `position:fixed`
     y crea contexto de apilamiento: un panel a pantalla completa adentro queda
     recortado por sus 72px de alto. -->
<div class="bl-panel" id="bl-panel">
  <div class="bl-panel-velo" data-cerrar></div>
  <div class="bl-panel-caja" role="dialog" aria-modal="true" aria-label={t('footer.nav.title')}>
    <div class="bl-panel-top">
      <img src="/logobrickell.png" alt="Brickell Lab" decoding="async" />
      <button class="bl-cerrar" type="button" aria-label="Cerrar" data-cerrar>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    {links.map((l) => <a class="bl-panel-link" href={l.href} data-cerrar>{l.label}</a>)}

    <a class="bl-btn bl-btn--acento" href="#contacto" data-cerrar>{t('ag.cta')}</a>
  </div>
</div>

<script>
  const nav = document.getElementById('bl-nav');
  const panel = document.getElementById('bl-panel');
  const burger = document.getElementById('bl-burger');

  /* El vidrio de la barra. Un observador sobre un centinela sería más prolijo,
     pero acá alcanza con un umbral fijo y un listener pasivo: es una clase que
     se pone una vez y no se toca más. */
  if (nav) {
    const alScrollear = () => nav.classList.toggle('is-scroll', window.scrollY > 12);
    alScrollear();
    window.addEventListener('scroll', alScrollear, { passive: true });
  }

  if (panel && burger) {
    const abrir = () => {
      panel.setAttribute('data-abierto', '');
      burger.setAttribute('aria-expanded', 'true');
      /* El scroll del fondo se bloquea, si no el dedo mueve la página de atrás
         en vez del panel. */
      document.body.style.overflow = 'hidden';
    };
    const cerrar = () => {
      panel.removeAttribute('data-abierto');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    burger.addEventListener('click', abrir);
    /* Todo lo que lleve `data-cerrar` cierra: el velo, la cruz y cada link.
       Los links además navegan al ancla, y por eso cierran ellos también: si no,
       el panel se queda abierto tapando la sección a la que acabás de ir. */
    for (const el of panel.querySelectorAll('[data-cerrar]')) {
      el.addEventListener('click', cerrar);
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.hasAttribute('data-abierto')) cerrar();
    });
  }
</script>
