---
// src/components/Hero.astro
import { useTranslations } from '../i18n/utils';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const madre = new Date('2024-09-10T00:00:00');
const hoy = new Date();
const years = Math.max(1, Math.round((hoy.getTime() - madre.getTime()) / (365.25 * 24 * 3600 * 1000)));

const tags = [t('hero.tag.0'), t('hero.tag.1'), t('hero.tag.2'), t('hero.tag.3'), t('hero.tag.4')];
const stats = [
  { n: 70, suffix: '+', label: t('hero.stat.projects') },
  { n: years, suffix: '', label: t('hero.stat.years') },
  { n: 4, suffix: '', label: t('hero.stat.countries') },
];
---
<section class="hero" aria-label="Brickell Lab">
  <div class="hero-content">
    <div class="hero-inner">
      <p class="hero-eyebrow">
        <img class="hero-eyebrow-logo" src="/logobrickell.png" alt="Brickell Lab" decoding="async" />
      </p>

      <h1 class="hero-title">
        <span class="sr-only">{t('hero.seo')}</span>
        <span aria-hidden="true">
          {t('hero.title.line1')}<br />{t('hero.title.line2')}
          <em class="hero-title-accent">{t('hero.title.accent')}</em>
        </span>
      </h1>

      <p class="hero-lede">
        {t('hero.lede')}
      </p>

      <ul class="hero-tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>

      <div class="hero-stats">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-num" data-plus={s.suffix}><span class="stat-count" data-count={s.n}>{s.n}</span></span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="hero-media">
    <picture>
      <source media="(max-width: 900px) and (orientation: portrait)" srcset="/slide1mobile.jpg" />
      <img src="/slide1.jpg" alt={t('hero.img.alt')} fetchpriority="high" loading="eager" decoding="async" />
    </picture>
  </div>
</section>

<style>
  .sr-only{
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }

.hero{
    position:relative;
    width:100%; max-width:100%;
    display:grid; grid-template-columns:1fr 1fr; gap:0;
    align-items:stretch;
    height:var(--app-h, 100dvh); min-height:var(--app-h, 100dvh);
    background:var(--surface); overflow:hidden;
  }

  .hero-content{
    position:relative; min-width:0; height:100%;
    display:flex; align-items:center;
    padding:clamp(24px,4vh,56px) clamp(28px,4vw,64px);
    padding-left:var(--gutter) !important;
    overflow:auto;
  }
  .hero-inner{ width:100%; }

  /* Antetítulo: solo el logo */
  .hero-eyebrow{ margin:0 0 clamp(20px,3vh,32px); }
  .hero-eyebrow-logo{ height:clamp(26px,3vw,38px); width:auto; display:block; }

  /* Título */
  .hero-title{
    margin:0; color:var(--text-primary);
    font-weight:var(--fw-bold); font-size:clamp(34px,4.6vw,66px);
    line-height:1.03; letter-spacing:-.04em; text-wrap:balance;
  }
  .hero-title-accent{
    display:block; font-style:italic; font-weight:var(--fw-semibold);
    color:var(--magenta); letter-spacing:-.035em;
  }

  .hero-lede{
    margin:clamp(16px,2.4vh,26px) 0 0; max-width:44ch;
    font-size:clamp(15px,1.15vw,18px); line-height:1.5; color:var(--text-secondary);
  }

  /* Pills */
  .hero-tags{ list-style:none; display:flex; flex-wrap:wrap; gap:7px; padding:0; margin:clamp(20px,2.8vh,32px) 0 0; }
  .hero-tags li{
    font-size:9.5px; font-weight:var(--fw-semibold); letter-spacing:.11em; text-transform:uppercase;
    color:var(--text-secondary); border:1px solid var(--border); border-radius:var(--r-pill); padding:5px 11px;
  }

  /* Números */
  .hero-stats{ display:flex; align-items:center; gap:clamp(20px,2.6vw,36px); margin-top:clamp(26px,3.6vh,44px); }
  .stat{ display:flex; flex-direction:column; }
  .stat + .stat{ padding-left:clamp(20px,2.6vw,36px); border-left:1px solid var(--border); }
  .stat-num{
    display:block; font-weight:var(--fw-bold); font-size:clamp(30px,3vw,44px);
    line-height:1; letter-spacing:-.035em; color:var(--text-primary); font-variant-numeric:tabular-nums;
  }
  .stat-num::before{ content:attr(data-plus); color:var(--text-primary); }
  .stat-label{ display:block; margin-top:9px; font-size:10.5px; font-weight:var(--fw-semibold); letter-spacing:.14em; text-transform:uppercase; color:var(--text-muted); }

  /* Imagen a sangre: mitad derecha exacta, todo el alto */
  .hero-media{
    position:absolute; top:0; right:0; bottom:0;
    width:50%; margin:0; padding:0; overflow:hidden;
  }
  .hero-media img{
    position:absolute; inset:0; width:100%; height:100%;
    object-fit:cover; display:block; margin:0;
  }
  /* Degradado blanco desde la izquierda (funde la foto con el texto) */
  .hero-media::before{ display:none; }

  /* Entrada */
  @keyframes hRise{ from{ opacity:0; transform:translateY(14px); } to{ opacity:1; transform:none; } }
  .hero-eyebrow{ opacity:0; animation:hRise .6s var(--ease-out) .05s forwards; }
  .hero-title{ opacity:0; animation:hRise .7s var(--ease-out) .16s forwards; }
  .hero-lede{ opacity:0; animation:hRise .7s var(--ease-out) .28s forwards; }
  .hero-tags{ opacity:0; animation:hRise .7s var(--ease-out) .4s forwards; }
  .hero-stats{ opacity:0; animation:hRise .7s var(--ease-out) .52s forwards; }
  @keyframes hFadeImg{ from{ opacity:0; } to{ opacity:1; } }
  .hero-media img{ opacity:0; animation:hFadeImg .9s var(--ease-out) .1s forwards; }

/* ===== FORMA ALTA — mobile vertical + tablet vertical ===== */
  @media (max-width:900px) and (orientation:portrait){
    .hero{
      display:flex; flex-direction:column;
      width:100%; max-width:100%;
      min-height:100vh; height:100vh;
      padding:0; overflow:hidden;
    }
    .hero-media{
      position:relative; order:1; width:100%; height:44vh;
      flex:0 0 auto; margin:0;
    }
    .hero-media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center bottom; }
    .hero-media::before{
      display:none;
    }
    .hero-eyebrow{ display:none; }
    .hero-content{
      order:2; flex:1 1 auto;
      display:flex; flex-direction:column; justify-content:flex-start;
      padding:clamp(20px,5vw,32px) clamp(24px,7vw,40px) clamp(32px,8vw,48px);
      overflow:visible;
    }
    .hero-stats{ gap:clamp(22px,7vw,42px); }
  }

  /* ===== MOBILE HORIZONTAL / pantallas bajas ===== */
  @media (orientation:landscape) and (max-height:600px){
    .hero{ grid-template-columns:1fr 1fr; height:auto; min-height:100svh; }
    .hero-content{
      justify-content:center;
      padding:14px clamp(20px,3vw,36px) 14px clamp(24px,4vw,48px);
      overflow:auto;
    }
    .hero-eyebrow{ margin:0 0 16px; }
    .hero-eyebrow-logo{ height:24px; }
    .hero-title{ font-size:clamp(21px,3.6vw,32px); line-height:1.1; }
    .hero-lede{ font-size:13px; line-height:1.5; margin-top:14px; max-width:44ch; }
    .hero-tags{ margin-top:18px; gap:7px; }
    .hero-tags li{ font-size:8.5px; padding:5px 10px; }
    .hero-stats{ margin-top:20px; gap:clamp(16px,2vw,24px); }
    .stat + .stat{ padding-left:clamp(16px,2vw,24px); }
    .stat-num{ font-size:clamp(21px,2.4vw,27px); }
    .stat-label{ font-size:8.5px; margin-top:6px; }
  }

  @media (prefers-reduced-motion:reduce){
    .hero-eyebrow, .hero-title, .hero-lede, .hero-tags, .hero-stats, .hero-media img{ opacity:1; animation:none; transform:none; }
  }
</style>

<script is:inline>
  (function(){
    var els = document.querySelectorAll('.stat-count');
    if(!els.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce){ els.forEach(function(el){ el.textContent = el.dataset.count; }); return; }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if(!entry.isIntersecting) return;
        var el = entry.target; io.unobserve(el);
        var target = +el.dataset.count, dur = 2000, t0 = performance.now();
        (function tick(now){
          var p = Math.min(1,(now-t0)/dur), eased = 1-Math.pow(1-p,3);
          el.textContent = Math.round(target*eased);
          if(p<1) requestAnimationFrame(tick); else el.textContent = target;
        })(t0);
      });
    },{ threshold:.5 });
    els.forEach(function(el){ el.textContent = '0'; io.observe(el); });
  })();
</script>