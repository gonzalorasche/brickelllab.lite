---
// src/components/SeoSchemaLumina.astro
interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const p = lang === 'en' ? '/en' : '';
const inLang = lang === 'en' ? 'en-US' : 'es-AR';

const tx = {
  es: {
    desc: "Plataforma de gestión integral de eventos: invitados, confirmaciones, asignación de mesas, diseño del salón, transporte, cronograma, tareas e invitaciones digitales.",
    features: ["Gestión de invitados y confirmaciones","Invitación digital","Asignación de mesas y diseño del salón","Servicio de transporte","Cronograma del evento","Gestión de tareas","Mensajes de invitados"],
    pageName: "Lúmina | Gestión integral de eventos",
    pageDesc: "Plataforma para gestionar tu evento de principio a fin.",
  },
  en: {
    desc: "End-to-end event management platform: guests, RSVPs, table assignment, venue layout, transport, schedule, tasks and digital invitations.",
    features: ["Guest and RSVP management","Digital invitation","Table assignment and venue layout","Transport service","Event schedule","Task management","Guest messages"],
    pageName: "Lúmina | End-to-end event management",
    pageDesc: "Platform to manage your event from start to finish.",
  },
}[lang];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://lumina.labbrickell.com.ar/#lumina",
      "name": "Lúmina",
      "url": `https://labbrickell.com.ar${p}/lumina`,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "image": "https://labbrickell.com.ar/og-image.jpg",
      "description": tx.desc,
      "parentOrganization": { "@id": "https://labbrickell.com.ar/#organization" },
      "sameAs": "https://lumina.labbrickell.com.ar/",
      // La plataforma es SÓLO en español: es un dato del producto, no de la
      // página que lo presenta. Por eso va fijo y no `inLang` — /en/lumina está
      // en inglés y habla de una aplicación que no lo está.
      "inLanguage": "es-AR",
      "offers": { "@type": "Offer", "category": "SaaS" },
      "featureList": tx.features
    },
    {
      "@type": "WebPage",
      "@id": `https://labbrickell.com.ar${p}/lumina#webpage`,
      "url": `https://labbrickell.com.ar${p}/lumina`,
      "name": tx.pageName,
      "description": tx.pageDesc,
      "isPartOf": { "@id": "https://labbrickell.com.ar/#website" },
      "about": { "@id": "https://lumina.labbrickell.com.ar/#lumina" },
      "inLanguage": inLang
    }
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />