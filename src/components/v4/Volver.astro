---
// ⚠️ LA FLECHITA DE VOLVER, FLOTANTE Y SOLO EN EL TELÉFONO (en escritorio cada
// página pone su enlace de texto). Es `fixed`, así que va FUERA del contenedor
// del smoother: si queda adentro, el transform del contenido la rompe.
interface Props {
  href: string
  etiqueta?: string
}
const { href, etiqueta = 'Volver' } = Astro.props
---
<a class="volver" href={href} aria-label={etiqueta}>
  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>

<style>
  .volver { position: fixed; z-index: 70; left: var(--margen); top: calc(var(--barra) + 12px); display: none; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: rgba(255,255,255,.86); color: var(--tinta); border: 1px solid var(--linea); box-shadow: 0 10px 30px -18px rgba(11,11,15,.5); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .volver svg { width: 16px; height: 16px; }
  @media (max-width: 899px) { .volver { display: grid; } }
</style>
