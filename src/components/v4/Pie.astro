---
// ============================================================
// EL PIE — con la misma anatomía que el de la plataforma de Lúmina
// ============================================================
// ⚠️ EL PIE NO SE ANIMA: está siempre visible y disponible (lo pidió Gonzalo).
// Nada de `data-entra` acá: si algo falla con las entradas, el pie tiene que
// estar igual.
// Dos zonas: la NAVEGACIÓN (la marca con su frase y el mail a la izquierda,
// dos columnas de enlaces a la derecha) y la BANDA DE CIERRE (copyright, las
// redes agrupadas con su rótulo al lado, y los legales). Es oscuro: es lo
// último que se ve y es lo que dice "se acabó". Sin última llamada a la
// acción: el contacto ya está justo arriba.
import { MAIL, INSTAGRAM, LINKEDIN, LUMINA_URL, LUMINA_INSTAGRAM, LUMINA_TIKTOK, LUMINA_FACEBOOK, LEXA_WHATSAPP_URL } from '../../data/v4/contacto'
import { GA_ID } from '../../data/v4/analitica'
const ANO = new Date().getFullYear()
const SECCIONES = [
  ['#hacemos', 'Qué hacemos'], ['#estudio', 'El estudio'], ['#proyectos', 'Proyectos'], ['#lumina', 'Lúmina'],
  ['#lexa', 'Lexa'], ['#blog', 'Blog'], ['#contacto', 'Contacto'],
]
// Instagram y LinkedIn no van acá: ya están en la banda de abajo y en
// Contacto (Gonzalo los sacó para no repetirlos tres veces).
const FUERA = [
  [LUMINA_URL, 'Entrar a Lúmina'], [LEXA_WHATSAPP_URL, 'Lexa por WhatsApp'],
]
---
<footer class="pie">
  <div class="centro pie__nav">
    <div class="pie__marca">
      <img class="pie__logo" src="/v4/logo-brickell-blanco.png" alt="Brickell Lab" width="1312" height="234" loading="lazy" decoding="async" />
      <p>Estudio de diseño y desarrollo web. Sitios, plataformas y productos digitales, de la idea al código.</p>
      <a class="pie__mail" href={`mailto:${MAIL}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {MAIL}
      </a>
    </div>
    <nav class="pie__cols" aria-label="Pie de página">
      <div>
        <span class="pie__tit">Esta página</span>
        <ul>{SECCIONES.map(([h, t]) => <li><a href={h}>{t}</a></li>)}</ul>
      </div>
      <div>
        <span class="pie__tit">Fuera de acá</span>
        <ul>{FUERA.map(([h, t]) => <li><a href={h} target="_blank" rel="noopener">{t} <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>)}</ul>
      </div>
    </nav>
  </div>

  <div class="pie__banda">
    <div class="centro pie__fila">
      <span class="pie__copy">© {ANO} Brickell Lab · Buenos Aires</span>
      <div class="pie__redes">
        <div class="pie__grupo">
          <span class="pie__q">Brickell Lab</span>
          <a class="rs" href={INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram de Brickell Lab"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
          <a class="rs" href={LINKEDIN} target="_blank" rel="noopener" aria-label="LinkedIn de Brickell Lab"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg></a>
        </div>
        <div class="pie__grupo">
          <span class="pie__q">Lúmina</span>
          <a class="rs" href={LUMINA_INSTAGRAM} target="_blank" rel="noopener" aria-label="Instagram de Lúmina"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
          <a class="rs" href={LUMINA_TIKTOK} target="_blank" rel="noopener" aria-label="TikTok de Lúmina"><svg viewBox="0 0 24 24"><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14 4c.4 2.4 2 4 4.5 4.3"/></svg></a>
          <a class="rs" href={LUMINA_FACEBOOK} target="_blank" rel="noopener" aria-label="Facebook de Lúmina"><svg viewBox="0 0 24 24"><path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6H14v-6h2.5l.5-3.5h-3V8z"/></svg></a>
        </div>
      </div>
      <div class="pie__legales">
        <a href="/terminos/">Términos y condiciones</a>
        <a href="/privacidad/">Política de privacidad</a>
        {GA_ID && <button class="pie__cookies" type="button" onclick="window.abrirCookies && window.abrirCookies()">Cookies</button>}
      </div>
    </div>
  </div>
</footer>

<style>
  /* ⚠️ EL MARGEN LATERAL VA EN EL CONTENEDOR DE AFUERA, NUNCA EN EL .centro:
     si no se suman los dos y el pie queda más adentro que el logo de la barra. */
  .pie { background: #0B0B0F; color: #fff; overflow: clip; padding: 0 var(--margen); }
  .pie__nav { display: grid; gap: clamp(28px, 4vw, 72px); padding: clamp(38px, 6svh, 64px) 0 clamp(30px, 4.4svh, 48px); }
  .pie__logo { display: block; width: 156px; height: auto; }
  .pie__marca p { margin-top: 15px; font-size: 13.5px; line-height: 1.55; color: rgba(255,255,255,.62); max-width: 38ch; }
  .pie__mail { display: inline-flex; align-items: center; gap: 8px; margin-top: 15px; font-size: 13.5px; color: rgba(255,255,255,.62); transition: color .18s ease; }
  .pie__mail svg { width: 14px; height: 14px; }
  .pie__mail:hover { color: #fff; }
  .pie__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 48px); }
  .pie__tit { display: block; font-family: var(--mono); font-size: 10px; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; color: rgba(255,255,255,.42); }
  .pie__cols ul { margin-top: 14px; display: grid; gap: 9px; }
  .pie__cols a { display: inline-flex; align-items: center; gap: 5px; font-size: 13.5px; color: rgba(255,255,255,.62); transition: color .18s ease; }
  .pie__cols a svg { width: 11px; height: 11px; }
  .pie__cols a:hover { color: #fff; }
  /* La banda es full-bleed: sale del padding del pie y lo vuelve a poner adentro. */
  .pie__banda { border-top: 1px solid rgba(255,255,255,.1); background: rgba(0,0,0,.28); margin: 0 calc(-1 * var(--margen)); padding: 0 var(--margen); }
  .pie__fila { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px clamp(16px, 2vw, 32px); padding: clamp(14px, 2.2svh, 20px) 0; }
  .pie__copy { font-size: 11.5px; color: rgba(255,255,255,.42); }
  .pie__redes { display: flex; align-items: center; flex-wrap: wrap; gap: clamp(14px, 2vw, 26px); }
  .pie__grupo { display: flex; align-items: center; gap: 9px; }
  .pie__q { font-family: var(--mono); font-size: 10px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.42); }
  .rs { display: inline-flex; color: rgba(255,255,255,.5); transition: color .18s ease, transform .18s ease; }
  .rs svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .rs:hover { color: #fff; transform: translateY(-1px); }
  .pie__legales { display: flex; flex-wrap: wrap; gap: clamp(12px, 1.6vw, 22px); }
  .pie__legales a, .pie__cookies { font-size: 11.5px; color: rgba(255,255,255,.42); transition: color .18s ease; }
  .pie__legales a:hover, .pie__cookies:hover { color: #fff; }
  /* El botón para volver a elegir las cookies se ve igual que los legales. */
  .pie__cookies { border: 0; background: none; font-family: inherit; padding: 0; cursor: pointer; }
  @media (min-width: 900px) { .pie__nav { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
</style>
