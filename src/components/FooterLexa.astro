---
// src/components/FooterLexa.astro
import { useTranslations } from '../i18n/utils';

interface Props { lang?: 'es' | 'en'; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const p = lang === 'en' ? '/en' : '';
const waText = lang === 'en'
  ? 'Hi, I would like to get in touch about Lexa translation services'
  : 'Hola, quiero contactarme por el servicio de traducciones de Lexa';
const waLexa = `https://wa.me/5491164680800?text=${encodeURIComponent(waText)}`;
const year = new Date().getFullYear();
---
<footer class="lxf">
  <div class="lxf-in">
    <div class="lxf-top">
      <div class="lxf-brand">
        <img class="lxf-logo" src="/logolexa.png" alt="Lexa" decoding="async" />
        <p class="lxf-tag">{t('lxf.tag.pre')}<a href={p || '/'}>{t('lxf.tag.link')}</a>{t('lxf.tag.post')}</p>
      </div>
      <div class="lxf-links">
        <a href={waLexa} target="_blank" rel="noopener">WhatsApp</a>
        <a href={p || '/'}>{t('lxf.back')}</a>
      </div>
    </div>
    <div class="lxf-bottom">
      <span>© {year} Lexa · Brickell Lab. {t('lxf.rights')}</span>
      <div class="lxf-legal">
        <a href={`${p}/terminos`}>{t('footer.legal.terms')}</a>
        <a href={`${p}/privacidad`}>{t('footer.legal.privacy')}</a>
        <button type="button" id="lxfCookies" class="lxf-cookies">{t('footer.legal.cookies')}</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .lxf{ width:100%; background:#0B0B0B; color:#EDEDED; }
  .lxf-in{ width:100%; padding:clamp(48px,6vw,72px) var(--gutter) clamp(24px,3vw,32px); }
  .lxf-top{
    display:flex; align-items:flex-start; justify-content:space-between; gap:clamp(28px,4vw,56px); flex-wrap:wrap;
    padding-bottom:clamp(32px,4vw,44px);
  }
  .lxf-logo{ height:26px; width:auto; display:block; filter:brightness(0) invert(1); }
  .lxf-tag{ margin:16px 0 0; max-width:44ch; font-size:14px; line-height:1.6; color:rgba(255,255,255,.6); }
  .lxf-tag a{ color:var(--magenta); text-decoration:none; }
  .lxf-tag a:hover{ text-decoration:underline; }
  .lxf-links{ display:flex; flex-direction:column; gap:10px; }
  .lxf-links a{ font-size:14.5px; color:rgba(255,255,255,.75); text-decoration:none; transition:color var(--dur) var(--ease); }
  .lxf-links a:hover{ color:var(--magenta); }
  .lxf-bottom{
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    padding-top:clamp(22px,3vw,28px); border-top:1px solid rgba(255,255,255,.12);
    font-size:13px; color:rgba(255,255,255,.5);
  }
  .lxf-legal{ display:flex; gap:20px; flex-wrap:wrap; }
  .lxf-legal a{ color:rgba(255,255,255,.5); text-decoration:none; transition:color var(--dur) var(--ease); }
  .lxf-legal a:hover{ color:#fff; }
  .lxf-cookies{
    font-family:inherit; font-size:13px; color:rgba(255,255,255,.5);
    background:none; border:0; padding:0; cursor:pointer;
    transition:color var(--dur) var(--ease);
  }
  .lxf-cookies:hover{ color:#fff; }
  @media (max-width:560px){
    .lxf-bottom{ flex-direction:column; align-items:flex-start; gap:8px; }
  }
</style>

<script>
  // @ts-nocheck
  const lxfCookies = document.getElementById('lxfCookies');
  if (lxfCookies) {
    lxfCookies.addEventListener('click', () => {
      try { localStorage.removeItem('bl_cookie_consent'); } catch(e){}
      location.reload();
    });
  }
</script>